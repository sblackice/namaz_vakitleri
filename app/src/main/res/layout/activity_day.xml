<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:id="@+id/day_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/detail_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_hijri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_accent"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/detail_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_accent"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_text"
            style="@style/Body"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.15"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/detail_source"
            style="@style/Note"
            android:textColor="@color/text_main"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_note"
            style="@style/Note" />
    </LinearLayout>
    </ScrollView>
</LinearLayout>
