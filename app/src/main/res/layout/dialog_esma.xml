<?xml version="1.0" encoding="utf-8"?>
<!-- Bir isme dokununca açılan büyük pencere -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/esma_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/esma_d_no"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B0B0B0"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/esma_d_arapca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/esma_gold"
        android:textDirection="rtl"
        android:textSize="64sp" />

    <TextView
        android:id="@+id/esma_d_okunus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/esma_d_anlam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#E0E0E0"
        android:textSize="21sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/esma_d_prev"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="@drawable/esma_bar"
            android:contentDescription="Önceki isim"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/esma_d_play"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1.6"
            android:background="@drawable/esma_gold_button"
            android:gravity="center"
            android:text="▶ Dinle"
            android:textColor="#1A1A1A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/esma_d_next"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:background="@drawable/esma_bar"
            android:contentDescription="Sonraki isim"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="36sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/esma_d_close"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/esma_bar"
        android:gravity="center"
        android:text="Kapat"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
