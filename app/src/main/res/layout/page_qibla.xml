<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qibla_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <LinearLayout
        android:id="@+id/qibla_root"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/qibla_angle"
            style="@style/Body"
            android:gravity="center"
            android:textSize="19sp" />

        <tr.kolay.namazvakti.QiblaView
            android:id="@+id/qibla_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/qibla_state"
            style="@style/Body"
            android:gravity="center"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/qibla_heading"
            style="@style/Body"
            android:gravity="center"
            android:textColor="@color/text_past"
            android:textSize="16sp" />

        <TextView
            style="@style/Body"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/qibla_help"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
