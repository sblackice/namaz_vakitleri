<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="96dp"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:background="@drawable/date_box"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/day_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="?attr/colOnAccent"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colOnAccent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colOnAccent"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/day_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colText"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/day_weekday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colText"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/day_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colAccentText"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:paddingStart="6dp"
        android:text="›"
        android:textColor="?attr/colAccentText"
        android:textSize="40sp" />
</LinearLayout>
