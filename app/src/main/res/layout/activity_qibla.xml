<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qibla_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/Title"
        android:text="@string/qibla_title" />

    <TextView
        android:id="@+id/qibla_angle"
        style="@style/Body"
        android:textStyle="bold" />

    <tr.kolay.namazvakti.QiblaView
        android:id="@+id/qibla_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/qibla_state"
        style="@style/Body"
        android:gravity="center"
        android:textColor="@color/accent"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        style="@style/Note"
        android:layout_marginTop="4dp"
        android:text="@string/qibla_help" />

    <Button
        android:id="@+id/btn_qibla_back"
        style="@style/BigButton"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:text="@string/btn_back" />
</LinearLayout>
