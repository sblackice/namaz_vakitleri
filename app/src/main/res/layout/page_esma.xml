<?xml version="1.0" encoding="utf-8"?>
<!-- Esmâ-ül Hüsnâ: koyu zemin, 3 sütunlu kartlar (altın renkli Arapça isim, altında okunuş),
     altta yüzen "Liste / Tesbih" çubuğu ve yuvarlak "sırayla dinle" düğmesi. Renkler temadan bağımsızdır. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/esma_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/esma_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/esma_back"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/esma_circle"
                android:contentDescription="Geri"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="34sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/menu_esma"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/esma_info"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/esma_circle"
                android:contentDescription="Bilgi"
                android:gravity="center"
                android:text="i"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/list_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="110dp">

                <TextView
                    android:id="@+id/esma_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:textColor="@color/esma_gold"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/esma_fix_voice"
                    style="@style/BigButton"
                    android:layout_width="match_parent"
                    android:layout_margin="6dp"
                    android:background="@drawable/esma_gold_button"
                    android:text="Arapça Ses Paketini Yükle"
                    android:textColor="#1A1A1A"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/list_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:text="@string/esma_note"
                    android:textColor="#B0B0B0"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Sol alt: Liste / Tesbih -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="76dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:background="@drawable/esma_bar"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/esma_tab_list"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:background="@drawable/esma_bar_selected"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▦"
                android:textColor="@color/esma_green"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Liste"
                android:textColor="@color/esma_green"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/esma_tab_tesbih"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Tesbih (Zikirmatik)"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_zikir_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tesbih"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Sağ alt: hepsini sırayla dinle / durdur -->
    <TextView
        android:id="@+id/esma_play_all"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:background="@drawable/esma_bar"
        android:contentDescription="@string/esma_play_all"
        android:elevation="6dp"
        android:gravity="center"
        android:text="▶"
        android:textColor="#FFFFFF"
        android:textSize="32sp" />
</FrameLayout>
