<?xml version="1.0" encoding="utf-8"?>
<!-- Esmâ-ül Hüsnâ kartı: sıra numarası, Arapça isim, Türkçe okunuş, anlam ve dinleme düğmesi -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/row_normal"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/esma_no"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/esma_no"
                android:gravity="center"
                android:textColor="?attr/colOnAccent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/esma_arapca"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="?attr/colTitle"
                android:textDirection="rtl"
                android:textSize="34sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/esma_okunus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="?attr/colAccentText"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/esma_anlam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="?attr/colText"
            android:textSize="19sp" />
    </LinearLayout>

    <Button
        android:id="@+id/esma_dinle"
        style="@style/BigButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:minHeight="64dp"
        android:padding="0dp"
        android:text="▶"
        android:textSize="26sp" />
</LinearLayout>
