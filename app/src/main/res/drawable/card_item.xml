<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colAccentSoft" />
            <stroke android:width="2dp" android:color="?attr/colAccent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colSurface" />
            <stroke android:width="2dp" android:color="?attr/colBorder" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
