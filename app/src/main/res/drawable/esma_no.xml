<?xml version="1.0" encoding="utf-8"?>
<!-- Sıra numarasının arkasındaki sekiz köşeli yıldız -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <rotate android:fromDegrees="45" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="?attr/colAccent" />
                <size android:width="31dp" android:height="31dp" />
            </shape>
        </rotate>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colAccent" />
        </shape>
    </item>
</layer-list>
