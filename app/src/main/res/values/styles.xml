<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Renk temaları. Yazı/zemin karşıtlığı WCAG 2.1 ölçüsüyle kontrol edildi
         (normal yazı en az 4,5:1; düğme üstündeki büyük kalın yazı en az 3:1). -->

    <!-- 0: Krem üzerine Turkuaz (ilk tema, varsayılan) -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/accent_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/accent_dark</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="colBg">@color/bg</item>
        <item name="colSurface">@color/surface</item>
        <item name="colBorder">@color/border</item>
        <item name="colText">@color/text_main</item>
        <item name="colTextPast">@color/text_past</item>
        <item name="colAccent">@color/accent</item>
        <item name="colAccentDark">@color/accent_dark</item>
        <item name="colAccentLight">#5CC2C3</item>
        <item name="colAccentText">@color/accent_text</item>
        <item name="colOnAccent">@color/on_accent</item>
        <item name="colAccentSoft">@color/accent_soft</item>
        <item name="colHeaderBg">@color/header_bg</item>
        <item name="colTitle">@color/title_dark</item>
        <item name="colWarn">@color/warn</item>
        <item name="colOff">@color/off</item>
        <item name="colOffDark">@color/off_dark</item>
        <item name="colMinaret">@color/minaret</item>
        <item name="colScrim">#99000000</item>
    </style>

    <!-- 1: Beyaz üzerine Kırmızı -->
    <style name="Tema.KirmiziBeyaz" parent="AppTheme">
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:colorPrimary">#C62828</item>
        <item name="android:colorPrimaryDark">#8E1B1B</item>
        <item name="android:colorAccent">#C62828</item>
        <item name="android:statusBarColor">#8E1B1B</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="colBg">#FFFFFF</item>
        <item name="colSurface">#FFFFFF</item>
        <item name="colBorder">#D9C4C4</item>
        <item name="colText">#141414</item>
        <item name="colTextPast">#555555</item>
        <item name="colAccent">#C62828</item>
        <item name="colAccentDark">#8E1B1B</item>
        <item name="colAccentLight">#EF9A9A</item>
        <item name="colAccentText">#B71C1C</item>
        <item name="colOnAccent">#FFFFFF</item>
        <item name="colAccentSoft">#FDECEC</item>
        <item name="colHeaderBg">#FDEEEE</item>
        <item name="colTitle">#7F1414</item>
        <item name="colWarn">#8A4B00</item>
        <item name="colMinaret">#6B3A3A</item>
    </style>

    <!-- 2: Pudra üzerine Yeşil -->
    <style name="Tema.YesilPudra" parent="AppTheme">
        <item name="android:windowBackground">#F7E6E2</item>
        <item name="android:colorPrimary">#2E7D32</item>
        <item name="android:colorPrimaryDark">#1B5E20</item>
        <item name="android:colorAccent">#2E7D32</item>
        <item name="android:statusBarColor">#1B5E20</item>
        <item name="android:navigationBarColor">#FFF8F6</item>
        <item name="colBg">#F7E6E2</item>
        <item name="colSurface">#FFF8F6</item>
        <item name="colBorder">#D8BDB7</item>
        <item name="colText">#1A1A1A</item>
        <item name="colTextPast">#584B49</item>
        <item name="colAccent">#2E7D32</item>
        <item name="colAccentDark">#1B5E20</item>
        <item name="colAccentLight">#81C784</item>
        <item name="colAccentText">#1B5E20</item>
        <item name="colOnAccent">#FFFFFF</item>
        <item name="colAccentSoft">#E3F1E4</item>
        <item name="colHeaderBg">#FBEFEC</item>
        <item name="colTitle">#154A19</item>
        <item name="colMinaret">#5E5048</item>
    </style>

    <!-- 3: Pudra üzerine Turkuaz -->
    <style name="Tema.TurkuazPudra" parent="AppTheme">
        <item name="android:windowBackground">#F7E6E2</item>
        <item name="android:colorPrimary">#0F8C8F</item>
        <item name="android:colorPrimaryDark">#0A6E71</item>
        <item name="android:colorAccent">#0F8C8F</item>
        <item name="android:statusBarColor">#0A6E71</item>
        <item name="android:navigationBarColor">#FFF8F6</item>
        <item name="colBg">#F7E6E2</item>
        <item name="colSurface">#FFF8F6</item>
        <item name="colBorder">#D8BDB7</item>
        <item name="colText">#1A1A1A</item>
        <item name="colTextPast">#584B49</item>
        <item name="colAccent">#0F8C8F</item>
        <item name="colAccentDark">#0A6E71</item>
        <item name="colAccentLight">#5CC2C3</item>
        <item name="colAccentText">#0A6467</item>
        <item name="colOnAccent">#FFFFFF</item>
        <item name="colAccentSoft">#DDF1F1</item>
        <item name="colHeaderBg">#FBEFEC</item>
        <item name="colTitle">#064F52</item>
        <item name="colMinaret">#5E5048</item>
    </style>

    <!-- 4: Siyah üzerine Beyaz (koyu tema) -->
    <style name="Tema.BeyazSiyah" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorPrimary">#FFFFFF</item>
        <item name="android:colorPrimaryDark">#000000</item>
        <item name="android:colorAccent">#FFFFFF</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="colBg">#000000</item>
        <item name="colSurface">#141414</item>
        <item name="colBorder">#6A6A6A</item>
        <item name="colText">#FFFFFF</item>
        <item name="colTextPast">#BDBDBD</item>
        <item name="colAccent">#FFFFFF</item>
        <item name="colAccentDark">#CFCFCF</item>
        <item name="colAccentLight">#9E9E9E</item>
        <item name="colAccentText">#FFFFFF</item>
        <item name="colOnAccent">#000000</item>
        <item name="colAccentSoft">#2A2A2A</item>
        <item name="colHeaderBg">#141414</item>
        <item name="colTitle">#FFFFFF</item>
        <item name="colWarn">#FF7A7A</item>
        <item name="colOff">#4A4A4A</item>
        <item name="colOffDark">#333333</item>
        <item name="colMinaret">#BDBDBD</item>
        <item name="colScrim">#CC000000</item>
    </style>

    <!-- 5: Siyah üzerine Kırmızı (koyu tema) -->
    <style name="Tema.KirmiziSiyah" parent="Tema.BeyazSiyah">
        <item name="android:colorPrimary">#C62828</item>
        <item name="android:colorAccent">#FF5C5C</item>
        <item name="android:statusBarColor">#4A0E0E</item>
        <item name="colBorder">#7A3A3A</item>
        <item name="colTextPast">#C4C4C4</item>
        <item name="colAccent">#C62828</item>
        <item name="colAccentDark">#8E1B1B</item>
        <item name="colAccentLight">#EF5350</item>
        <item name="colAccentText">#FF5C5C</item>
        <item name="colOnAccent">#FFFFFF</item>
        <item name="colAccentSoft">#3A1414</item>
        <item name="colHeaderBg">#1A0A0A</item>
        <item name="colTitle">#FF6B6B</item>
        <item name="colWarn">#FFB74D</item>
        <item name="colMinaret">#C4A0A0</item>
    </style>

    <style name="BigButton" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:background">@drawable/button</item>
        <item name="android:textColor">?attr/colOnAccent</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="Title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colText</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colText</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Note">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">?attr/colTextPast</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="OffButton" parent="BigButton">
        <item name="android:background">@drawable/button_off</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">?attr/colAccentText</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">?attr/colTextPast</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
